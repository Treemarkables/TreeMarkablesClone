# Copy to android/keystore.properties (gitignored) and fill in your real values.
# The keystore file itself goes in android/ (e.g. android/inflow-upload.jks) and is
# also gitignored. NEVER commit either — losing the keystore means you can't update
# the app on Play (unless using Play App Signing, where this is just the upload key).
#
# Generate the keystore (one time):
#   keytool -genkey -v -keystore android/inflow-upload.jks \
#     -alias inflow -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=inflow-upload.jks
storePassword=CHANGE_ME
keyAlias=inflow
keyPassword=CHANGE_ME
