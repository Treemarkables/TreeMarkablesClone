# Copy to android-native/secrets.properties (gitignored) and fill in real values.
# These are injected into BuildConfig at build time so the secret never lands in git.
#
#   INFLOW_WEBHOOK_SECRET     = value of HERO_WEBHOOK_SECRET (DO env / Twilio webhook auth)
#   INFLOW_OWNER_EMPLOYEE_ID  = the owner's employee UUID (same one the iOS build uses)

INFLOW_WEBHOOK_SECRET=
INFLOW_OWNER_EMPLOYEE_ID=
