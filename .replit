modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["jq", "zip"]

[deployment]
deploymentTarget = "vm"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5904
externalPort = 3001

[[ports]]
localPort = 23636
externalPort = 3002

[[ports]]
localPort = 23637
externalPort = 3000

[[ports]]
localPort = 23638
externalPort = 6800

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
integrations = [
  "javascript_sendgrid:1.0.0",
  "javascript_openai:1.0.0",
  "javascript_database:1.0.0",
  "twilio:1.0.0",
  "javascript_object_storage:1.0.0",
  "google-calendar:1.0.0",
  "resend:1.0.0",
]

[objectStorage]
defaultBucketID = "replit-objstore-bab24a24-4208-4d38-af19-cd2b8f9946d4"

[userenv]

[userenv.shared]
FACEBOOK_WEBHOOK_VERIFY_TOKEN = "treemarkables-webhook-2026"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
